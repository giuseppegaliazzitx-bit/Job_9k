# Optional. Only needed if Settings → LLM provider is not "none".
# OpenAI-compatible (SpaceXAI / xAI, OpenAI, local llama.cpp, Ollama, etc.)
XAI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.x.ai/v1
OPENAI_MODEL=grok-4.6

# Anthropic (if you pick that provider in Settings)
ANTHROPIC_API_KEY=

# Override data directory (default ./data)
# JOB9K_DATA_DIR=./data
